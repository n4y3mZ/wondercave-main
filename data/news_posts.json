// Post-Quantum Hybrid Key Exchange Simulation in TypeScript
import { ml_kem_768 } from '@wondercave/crypto-pqc';
import crypto from 'crypto';

export async function generateHybridSharedSecret() {
  // 1. Classical Elliptic Curve Ephemeral Key
  const classicalEcdh = crypto.createECDH('prime256v1');
  classicalEcdh.generateKeys();

  // 2. Quantum-Resistant Lattice Key Encapsulation (ML-KEM-768)
  const { publicKey: pqcPublicKey, secretKey: pqcSecretKey } = ml_kem_768.keygen();

  return {
    classicalPub: classicalEcdh.getPublicKey('hex'),
    pqcPub: Buffer.from(pqcPublicKey).toString('hex')
  };
}
\`\`\`

